# Copy to .env at the repo root (gitignored). Never commit the real key.
# The render script reads this only on a real run. --dry-run does not.
#
# Do not synthesize until you have read the Azure Speech terms (P0.1) and they
# allow storing and redistributing the audio. The script cannot check that.
# Do not put the key in shell history if you can avoid it; this file is local.

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional. Default is /opt/homebrew/bin/ffmpeg.
# FFMPEG_PATH=
